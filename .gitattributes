# Preserve exported artifacts byte-for-byte on every platform.
*.pdf binary
*.pptx binary
*.zip binary
*.apk binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.bin binary
# Preserve the recorded byte stream used by the benchmark SHA-256 checks.
*.jsonl -text whitespace=cr-at-eol
